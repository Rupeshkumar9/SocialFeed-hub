{
  "manifest_version": 3,
  "name": "SocialFeed Bookmarks Exporter",
  "version": "1.2",
  "description": "Scrapes and exports saved bookmarks from Instagram and X with embedded Base64 thumbnails, using automated scroll scanning.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage",
    "bookmarks"
  ],
  "host_permissions": [
    "https://socialfeed-hub.onrender.com/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "*://*.instagram.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*",
    "*://*.twimg.com/*",
    "*://*.pbs.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SocialFeed Exporter",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
