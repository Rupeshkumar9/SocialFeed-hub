---
import { getCollection } from "astro:content";
import ComingSoon from "../../components/ComingSoon.astro";
import PublicLayout from "../../layouts/PublicLayout.astro";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const hasPosts = posts.length > 0;
---

<PublicLayout
  title="Journal · SocialFeed Hub"
  description="Notes on saving, organizing, and sharing the web."
  robots={hasPosts ? "index, follow" : "noindex, nofollow"}
>
  {
    hasPosts ? (
      <section class="section">
        <>
          <div class="eyebrow">The SocialFeed Hub journal</div>
          <h1>Notes for a better personal web.</h1>
          <div class="feature-grid">
            {posts.map((post) => (
              <article class="glass-card feature-card">
                <div class="eyebrow">
                  {post.data.publishDate.toLocaleDateString()}
                </div>
                <h2>
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p>{post.data.description}</p>
              </article>
            ))}
          </div>
        </>
      </section>
    ) : (
      <ComingSoon
        eyebrow="The journal is being prepared"
        title="Thoughtful notes are coming soon."
        description="The blog pipeline is ready for practical essays about personal knowledge, bookmarking, and building a calmer relationship with the internet."
        icon="✎"
        primaryLabel="Visit SocialFeed Hub"
        primaryHref="/"
      />
    )
  }
</PublicLayout>
