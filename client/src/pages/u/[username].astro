---
import PublicLayout from "../../layouts/PublicLayout.astro";
import PublicProfile from "../../components/profile/PublicProfile.astro";

export const prerender = false;
const username = Astro.params.username || "";
let profile = null;
let browserBookmarks = [];
let socialBookmarks = [];
let counts = {};
try {
  const apiJson = async (path) => {
    const response = await fetch(new URL(path, Astro.url), {
      headers: { accept: "application/json" },
      cache: "no-store",
    });
    if (!response.ok) return null;
    return response.json();
  };
  const profileResult = await apiJson(`/api/public-profile?username=${encodeURIComponent(username)}`);
  if (profileResult?.profile) {
    profile = profileResult.profile;
    counts = profile.counts || {};
    const browserResult = await apiJson(`/api/public-bookmarks?username=${encodeURIComponent(username)}&source=browser&limit=12`);
    const socialResult = await apiJson(`/api/public-bookmarks?username=${encodeURIComponent(username)}&source=social&limit=12`);
    browserBookmarks = browserResult?.bookmarks || [];
    socialBookmarks = socialResult?.bookmarks || [];
  }
} catch (error) {
  console.error("Public profile SSR failed:", error);
}
if (!profile) {
  Astro.response.status = 404;
}
const displayName = profile?.displayName || username;
const description =
  profile?.bio || `Public links and collections curated by ${displayName}.`;
const canonical = new URL(
  `/u/${encodeURIComponent(username)}/`,
  Astro.site || Astro.url,
).href;
const jsonLd = profile
  ? {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      name: displayName,
      description,
      url: canonical,
      mainEntity: {
        "@type": "Person",
        name: displayName,
        alternateName: profile.username,
      },
    }
  : undefined;
---

<PublicLayout
  title={profile
    ? `${displayName} · SocialFeed Hub`
    : "Profile not found · SocialFeed Hub"}
  description={description}
  canonical={canonical}
  robots={profile ? "index, follow" : "noindex, nofollow"}
  jsonLd={jsonLd}
  profilePage={Boolean(profile)}
>
  {
  profile ? (
      <PublicProfile profile={profile} browserBookmarks={browserBookmarks} socialBookmarks={socialBookmarks} />
    ) : (
      <section class="coming-soon-wrap">
        <article class="glass-card coming-soon-card">
          <div class="coming-soon-content">
            <>
              <div class="coming-soon-icon" aria-hidden="true">
                ?
              </div>
              <div class="eyebrow">404</div>
              <h1>Profile not found.</h1>
              <p>This profile is unavailable or private.</p>
              <div class="coming-soon-actions">
                <a class="button primary" href="/">
                  Back home
                </a>
              </div>
            </>
          </div>
        </article>
      </section>
    )
  }
</PublicLayout>
