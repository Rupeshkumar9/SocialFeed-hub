      </div>
    </div>

    <!-- Read Full Post & Edit Note Modal Overlay -->
    <div class="modal-overlay" id="post-modal-overlay">
      <div class="modal-box post-modal-box">
        <div class="modal-header" style="border-bottom: none; padding-bottom: 0;">
          <h3>View Bookmark Post</h3>
          <button class="close-btn" id="close-post-modal">&times;</button>
        </div>
        <div class="modal-body" style="padding-top: 10px;">
          <!-- Card content display -->
          <div class="modal-post-card" id="modal-post-card-content">
            <!-- Dynamically populated -->
          </div>

          <!-- Note block -->
          <div class="modal-note-section" style="margin-top: 20px; display: flex; flex-direction: column; gap: 8px;">
            <label for="modal-note-textarea"
              style="font-size: 0.9rem; font-weight: 700; color: var(--text-primary);">Your Note</label>
            <textarea id="modal-note-textarea" class="notes-textarea"
              style="min-height: 120px; width: 100%; box-sizing: border-box;"
              placeholder="Add your insights, thoughts, or notes about this post..."></textarea>
            <div style="display: flex; justify-content: flex-end; font-size: 0.75rem; color: var(--text-muted);"
              id="modal-note-char-count">
              0 / 1000
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bulk Edit Modal Overlay -->
    <div class="modal-overlay" id="bulk-edit-modal-overlay">
      <div class="modal-box bulk-edit-box">
        <div class="modal-header">
          <h3>Bulk Edit Bookmarks</h3>
          <button class="close-btn" id="close-bulk-edit-modal">&times;</button>
        </div>
        <form id="bulk-edit-form">
          <div class="modal-body bulk-edit-body">
            <p id="bulk-edit-count-label">Editing 0 selected bookmarks.</p>

            <!-- Category Edit -->
            <div class="form-group">
              <label for="bulk-edit-category" class="form-label">Category</label>
              <select id="bulk-edit-category" class="filter-select"
                >
                <option value="__no_change__">Keep Original</option>
                <option value="">Others</option>
                <!-- Other categories will be dynamically loaded -->
              </select>
              <input type="text" id="bulk-edit-category-new" class="modal-input"
                placeholder="Enter new category name..."
                >
            </div>

            <!-- Author / site name metadata -->
            <div class="form-group">
              <label for="bulk-edit-author-name" id="bulk-edit-author-label" class="form-label">Author / Site name</label>
              <input type="text" id="bulk-edit-author-name" class="modal-input"
                placeholder="Leave blank to keep each original"
                autocomplete="off">
              <small style="display: block; margin-top: 4px; color: var(--text-secondary);">Applies one display name to every selected bookmark. Social posts use the author name; browser bookmarks use the site name.</small>
            </div>

            <!-- Notes metadata -->
            <div class="form-group">
              <label for="bulk-edit-notes-mode" class="form-label">Notes</label>
              <select id="bulk-edit-notes-mode" class="filter-select">
                <option value="__no_change__">Keep Original</option>
                <option value="append">Append Note</option>
                <option value="replace">Replace Notes</option>
                <option value="clear">Clear Notes</option>
              </select>
              <textarea id="bulk-edit-notes" class="notes-textarea" style="min-height: 72px;"
                placeholder="Enter a note to apply to the selected bookmarks..."></textarea>
            </div>
          </div>
          <div class="modal-footer bulk-edit-footer">
            <button type="button" class="btn-secondary" id="btn-bulk-edit-cancel">Cancel</button>
            <button type="submit" class="btn-primary bulk-edit-submit">Apply Changes</button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <!-- Social Widgets Embed Scripts (will be control loaded on demand by embeds.js) -->
  <!-- We do NOT pre-load the scripts synchronously to prevent visual lag; scripts are dynamically fetched -->
