              <small class="form-help-text">A globe icon will be used. The platform stays in the sidebar while it has bookmarks.</small>
            </div>

            <div style="display: flex; flex-direction: column; gap: 6px;">
              <label id="add-url-label" for="add-url" style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Post URL</label>
              <input type="url" id="add-url" class="search-input" style="padding-left: 14px;"
