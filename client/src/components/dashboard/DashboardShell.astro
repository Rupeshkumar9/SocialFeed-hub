              <div id="add-preview-status" class="link-preview-status" hidden></div>
            </div>

            <div id="browser-icon-picker" class="browser-icon-picker" hidden>
              <label class="form-label" for="btn-select-browser-icon">Site icon</label>
              <div class="browser-icon-picker-row">
                <button type="button" id="browser-icon-preview" class="browser-icon-preview" title="Change site icon" aria-label="Change site icon">
                  <img id="browser-icon-preview-image" alt="" hidden>
                  <span id="browser-icon-preview-initial">S</span>
                  <span class="browser-icon-pencil" aria-hidden="true"><i class="app-icon icon-pen"></i></span>
                </button>
                <div class="browser-icon-picker-copy">
                  <small>Fetched automatically when available. Hover the icon and click the pencil to replace it.</small>
                </div>
              </div>
              <div id="browser-icon-picker-panel" class="browser-icon-picker-panel" hidden>
                <button type="button" id="browser-icon-dropzone" class="manual-image-dropzone browser-icon-dropzone">
                  <i class="app-icon icon-image"></i>
                  <span>Drop an icon here or click to choose</span>
                  <small>PNG, JPG, WebP, or GIF</small>
                </button>
                <button type="button" id="btn-clear-browser-icon" class="browser-icon-clear">Use fallback letter</button>
              </div>
              <input type="file" id="browser-icon-file" accept="image/*" hidden>
              <input type="hidden" id="browser-icon-value">
            </div>

            <div style="display: flex; flex-direction: column; gap: 6px;" id="add-category-group">
              <label for="add-category"
                style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Category</label>
              <div class="category-select-row">
                <select id="add-category" class="filter-select" style="padding-left: 14px; width: 100%; height: 42px;">
                  <!-- Filled dynamically -->
                </select>
              </div>
              <input type="text" id="add-category-new" class="search-input"
                style="padding-left: 14px; margin-top: 6px; display: none;" placeholder="Enter new category name">
            </div>

            <div style="display: flex; flex-direction: column; gap: 6px;">
              <label id="add-author-label" for="add-author-name"
                style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Site name</label>
              <input type="text" id="add-author-name" class="search-input" style="padding-left: 14px;"
