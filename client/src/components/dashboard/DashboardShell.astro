                <i class="app-icon icon-image"></i><span>Add / Change Image</span>
              </button>
              <div id="add-image-field" class="manual-image-field" hidden>
                <div id="add-image-source-controls" class="manual-image-source-controls">
                  <label for="add-thumbnail" style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Image URL</label>
                  <input type="text" id="add-thumbnail" class="search-input" style="padding-left: 14px;" placeholder="Paste an image URL or leave blank">
                  <div class="manual-image-or"><span>or</span></div>
                  <button type="button" id="add-image-dropzone" class="manual-image-dropzone">
                    <i class="app-icon icon-image"></i>
                    <span>Drop image here or click to choose</span>
                    <small>PNG, JPG, WebP, or GIF</small>
                  </button>
                </div>
                <input type="file" id="add-image-file" accept="image/*" hidden>
                <div id="add-image-preview" class="manual-image-preview" hidden></div>
              </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 6px;">
              <label id="add-content-label" for="add-content"
                style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary);">Caption / Post
