---
---
  <div id="auth-loading" class="auth-loading" role="status">
    <span id="auth-loading-message">Checking your session…</span>
    <button id="auth-retry" class="btn-secondary" type="button" hidden>Retry</button>
  </div>
  <div id="login-gate" class="login-gate" aria-live="polite">
    <form id="private-login-form" class="login-card" data-auth-mode="login">
      <div class="logo-icon"><img class="brand-logo-image" src="/favicon.svg" alt=""></div>
      <h2 id="auth-form-title">Welcome back</h2>
      <p id="auth-form-description">Sign in to open your SocialFeed Hub workspace.</p>
      <div class="auth-mode-switch" role="group" aria-label="Account access mode">
        <button type="button" class="auth-mode-button active" id="auth-mode-login">Sign in</button>
        <button type="button" class="auth-mode-button" id="auth-mode-signup">Create account</button>
      </div>
      <label for="private-login-display-name" id="private-login-display-name-label" hidden>Display name</label>
      <input id="private-login-display-name" type="text" autocomplete="name" maxlength="80" placeholder="Your display name" hidden>
      <label for="private-login-username" id="private-login-username-label" hidden>Username</label>
      <input id="private-login-username" type="text" autocomplete="username" pattern="[a-zA-Z0-9][a-zA-Z0-9_-]{2,29}" maxlength="30" placeholder="your_username" hidden>
      <label for="private-login-email">Email</label>
      <input id="private-login-email" type="email" autocomplete="username" required placeholder="you@example.com">
      <label for="private-login-password">Password</label>
      <input id="private-login-password" type="password" autocomplete="current-password" minlength="10" required placeholder="Enter your password">
      <p id="private-login-error" class="login-error" hidden></p>
      <button id="private-login-submit" class="btn-primary login-submit" type="submit" aria-busy="false">
        <span>Sign in</span>
      </button>
    </form>
  </div>



  <div id="app-layout">
    <header class="main-header">
      <div class="header-left">
        <button id="mobile-menu-toggle" class="mobile-menu-toggle" title="Open Navigation Menu">
          <i class="app-icon icon-bars"></i>
        </button>
        <a href="/" class="logo-link">
          <div class="header-logo">
            <div class="logo-icon">
              <img class="brand-logo-image" src="/favicon.svg" alt="">
            </div>
            <div class="logo-text">
              <h1>SocialFeed</h1>
            </div>
          </div>
        </a>
      </div>

      <!-- search bar -->
      <div class="search-bar-container">
        <button id="search-toggle" class="search-toggle" type="button" aria-label="Open search" aria-expanded="false">
          <i class="app-icon icon-magnifying-glass" aria-hidden="true"></i>
          <span class="sr-only">Open search</span>
        </button>
        <i class="app-icon icon-magnifying-glass search-icon"></i>
        <input type="text" id="search-input" class="search-input" placeholder="Search author, content, tags, notes...">
      </div>

      <div class="header-right">
        <!-- read-only server/database status -->
        <button id="sync-btn" class="sync-status-btn" type="button" title="Checking server and database connection" aria-label="Checking server and database connection">
          <span class="sync-status-icon" id="sync-dot" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <circle class="sync-status-icon-circle" cx="12" cy="12" r="9"></circle>
              <path class="sync-status-icon-mark sync-status-icon-connected" d="M7.4 12.2 10.5 15.3 16.8 8.9"></path>
              <path class="sync-status-icon-mark sync-status-icon-offline" d="M12 7.4v5.7M12 16.8h.01"></path>
            </svg>
          </span>
          <span id="sync-status-text" class="btn-text">Server Connected</span>
        </button>

        <button id="theme-toggle" class="theme-toggle-btn" type="button" aria-pressed="false" title="Switch theme">
          <i class="app-icon icon-moon" aria-hidden="true"></i>
          <span class="sr-only">Switch theme</span>
        </button>

        <div class="public-account dashboard-account" id="dashboard-account">
          <button class="public-account-trigger" id="dashboard-account-trigger" type="button" aria-expanded="false" aria-haspopup="menu">
            <span class="public-account-avatar" id="dashboard-account-avatar" aria-hidden="true"><span class="public-account-avatar-fallback">S</span><img src="/favicon.svg" alt="" hidden /></span>
            <span class="public-account-copy"><strong id="dashboard-account-name">SocialFeed Owner</strong><small id="dashboard-account-username">@socialfeed</small></span>
            <span class="public-account-chevron" aria-hidden="true">⌄</span>
          </button>
          <div class="public-account-menu" id="dashboard-account-menu" role="menu" hidden>
            <a href="/u/socialfeed" id="btn-dashboard-visit-profile" role="menuitem"><i class="app-icon icon-globe"></i> Visit profile</a>
            <button type="button" id="btn-sync-now" role="menuitem"><i class="app-icon icon-rotate"></i> Sync</button>
            <button type="button" id="btn-dashboard-settings" role="menuitem"><i class="app-icon icon-gear"></i> Settings</button>
            <button type="button" id="btn-dashboard-logout" role="menuitem"><i class="app-icon icon-right-from-bracket"></i> Logout</button>
          </div>
        </div>

        <!-- Hidden elements for backward compatibility and JS selectors -->
        <div style="display: none;">
          <select id="filter-collection">
            <option value="all">All Collections</option>
            <option value="uncategorized">Others</option>
          </select>
          <select id="filter-platform">
            <option value="all">All Platforms</option>
            <option value="x">X / Twitter</option>
            <option value="instagram">Instagram</option>
            <option value="threads">Threads</option>
            <option value="reddit">Reddit</option>
            <option value="facebook">Facebook</option>
            <option value="youtube">YouTube</option>
          </select>
          <select id="filter-sort">
            <option value="recent-desc">Recently Added</option>
          </select>
          <div id="tags-dropdown">
            <button id="tags-dropdown-btn"></button>
            <div id="tags-dropdown-menu"></div>
          </div>
          <div id="feed-manager-dropdown">
            <button id="feed-manager-dropdown-btn"></button>
            <div id="feed-manager-dropdown-menu"></div>
          </div>
        </div>
      </div>
    </header>

    <div class="app-body">
      <button id="sidebar-collapse-toggle" class="sidebar-collapse-toggle" type="button"
        aria-label="Collapse sidebar" aria-expanded="true" title="Collapse sidebar">
        <i class="app-icon icon-sidebar" aria-hidden="true"></i>
      </button>
      <aside id="sidebar" class="app-sidebar">
        <div class="sidebar-menu">
          <section class="sidebar-section">
            <ul class="menu-list sidebar-primary-list" id="sidebar-primary-list">
              <li class="menu-item" id="sidebar-profile-item"><button type="button" id="btn-sidebar-profile" data-sidebar-route="/dashboard" aria-label="My Profile" title="My Profile"><i
                    class="app-icon icon-user"></i><span>My Profile</span></button></li>
              <li class="menu-item active" id="sidebar-browser-item"><button type="button" id="btn-browser-bookmarks" data-sidebar-route="#mylinks" aria-label="My Links" title="My Links"><i class="app-icon icon-bookmark"></i><span>My Links</span><span class="menu-count is-loading" id="count-browser-bookmarks" aria-busy="true"><i class="app-icon icon-circle-notch icon-spin" aria-hidden="true"></i><span class="sr-only">Loading count</span></span></button></li>
              <li class="menu-item" id="sidebar-social-posts-item"><button type="button" id="btn-social-posts" data-platform="all" data-sidebar-route="#platform=all" aria-label="Social Posts" title="Social Posts"><i
                    class="app-icon icon-circle-nodes"></i><span>Social Posts</span><span class="menu-count is-loading"
                    id="sidebar-count-platform-all" aria-busy="true"><i class="app-icon icon-circle-notch icon-spin" aria-hidden="true"></i><span class="sr-only">Loading count</span></span></button></li>
              <li class="menu-item" id="sidebar-analytics-item"><button type="button" id="btn-sidebar-analytics" aria-label="Analytics" title="Analytics"><i
                    class="app-icon icon-chart-line"></i><span>Analytics</span></button></li>
              <li class="menu-item" id="sidebar-extension-item"><button type="button" id="btn-sidebar-extension" data-sidebar-route="#extension" title="Extension"><i
                    class="app-icon icon-plug"></i><span>Extension</span></button></li>
            </ul>
          </section>

          <section class="sidebar-section">
            <div class="menu-section-title">Tools</div>
            <div class="sidebar-tools">
              <button type="button" class="sidebar-action sidebar-tool-placeholder" disabled title="AI Categorization — Coming soon">
                <i class="app-icon icon-circle-nodes"></i><span>AI Categorization</span><small>Coming soon</small>
              </button>
              <button type="button" class="sidebar-action sidebar-tool-placeholder" disabled title="Post Ideas — Coming soon">
                <i class="app-icon icon-note-sticky"></i><span>Post Ideas</span><small>Coming soon</small>
              </button>
              <button type="button" class="sidebar-action sidebar-tool-placeholder" disabled title="Visualize — Coming soon">
                <i class="app-icon icon-chart-line"></i><span>Visualize</span><small>Coming soon</small>
              </button>
              <button type="button" class="sidebar-action sidebar-tool-placeholder" disabled title="Auto Posts — Coming soon">
                <i class="app-icon icon-rotate"></i><span>Auto Posts</span><small>Coming soon</small>
              </button>
              <button type="button" class="sidebar-action sidebar-tool-placeholder" disabled title="MCP — Coming soon">
                <i class="app-icon icon-plug"></i><span>MCP</span><small>Coming soon</small>
              </button>
            </div>
          </section>
        </div>
      </aside>

      <main id="main-panel">
        <section id="settings-view" class="settings-view" hidden>
          <div class="settings-heading"><h2>Profile Settings</h2><p>Manage your private SocialFeed Hub account.</p></div>
          <div class="settings-layout">
            <div class="settings-main-column">
              <article class="settings-card"><h3><i class="app-icon icon-user"></i> Personal Information</h3><p>Update the account name and email used for your SocialFeed Hub workspace.</p><div class="settings-details account-details"><div class="account-detail-row"><div><span>Profile name</span><strong id="settings-profile-name">SocialFeed Owner</strong><input id="settings-profile-name-input" type="text" maxlength="80" autocomplete="name" hidden></div><button type="button" class="settings-inline-action account-edit-button" id="btn-edit-account-name">Edit</button></div><div class="account-detail-row"><div><span>Email address</span><strong id="settings-profile-email">Private account</strong><input id="settings-profile-email-input" type="email" autocomplete="email" hidden></div><button type="button" class="settings-inline-action account-edit-button" id="btn-edit-account-email">Edit</button></div><div><span>Account access</span><strong>Private dashboard</strong></div><div><span>Member since</span><strong id="settings-member-since">—</strong></div></div></article>
              <article class="settings-card"><h3><i class="app-icon icon-database"></i> Data management</h3><p>Import an archive or download a complete backup directly from MongoDB.</p><div class="settings-data-actions"><button type="button" class="settings-inline-action" id="action-import"><i class="app-icon icon-file-import"></i> Import Archive</button><button type="button" class="settings-inline-action" id="action-export-json"><i class="app-icon icon-download"></i> Export Full Backup</button></div></article>
              <article class="settings-card"><h3><i class="app-icon icon-lock"></i> Change password</h3><p>Use a new password of at least 10 characters.</p><form id="change-password-form" class="account-security-form"><label>Current password<input id="current-password" type="password" autocomplete="current-password" required></label><label>New password<input id="new-password" type="password" minlength="10" autocomplete="new-password" required></label><label>Confirm new password<input id="confirm-password" type="password" minlength="10" autocomplete="new-password" required></label><div class="settings-form-actions"><span id="change-password-status" role="status"></span><button type="submit" class="btn-primary" id="btn-change-password">Change password</button></div></form></article>
              <article class="settings-card danger-zone-card"><h3><i class="app-icon icon-trash"></i> Delete account</h3><p>Permanently delete your account, saved links, social posts, profile, and connected extensions.</p><button type="button" class="danger-action" id="btn-delete-account">Delete account</button></article>
              <article class="settings-card"><h3><i class="app-icon icon-credit-card"></i> Manage Your Subscription</h3><p class="coming-soon">Coming soon</p></article>
            </div>
            <aside class="settings-aside"><article class="settings-card"><h3>Account Security</h3><p>Your dashboard and bookmarks are only available after signing in.</p><span class="status-pill">Protected</span></article><button type="button" id="btn-settings-logout" class="settings-logout"><i class="app-icon icon-right-from-bracket"></i> Logout</button></aside>
          </div>
        </section>

        <section id="extension-view" class="settings-view extension-view" hidden>
          <div class="settings-heading"><h2>Extension</h2><p>Manage the browser extension and connected bookmark sources.</p></div>
          <div class="settings-layout">
            <div class="settings-main-column">
              <article class="settings-card"><h3><i class="app-icon icon-plug"></i> SocialFeed browser extension</h3><p>Connect the Instagram and X scanner extension to import saved posts into your workspace.</p><div class="integration-row"><div><strong>Connected browsers</strong><small id="extension-devices-status">Checking connected browsers…</small></div><button type="button" id="btn-revoke-extension-devices" class="settings-inline-action" hidden>Disconnect extensions</button></div></article>
              <article class="settings-card"><h3><i class="app-icon icon-bookmark"></i> Browser bookmarks</h3><p>The Chrome Browser Bookmarks scanner is ready to import links from your browser.</p><div class="integration-row"><span>Chrome Browser Bookmarks scanner</span><span class="status-pill">Ready</span></div></article>
            </div>
            <aside class="settings-aside"><article class="settings-card"><h3>Extension security</h3><p>Disconnecting removes access for every connected browser. You can pair them again later.</p><span class="status-pill">Protected</span></article></aside>
          </div>
        </section>

        <section id="profile-edit-view" class="settings-view profile-edit-view" hidden>
          <div class="settings-heading"><h2>My Profile</h2><p>Choose what visitors see, or update the identity behind your public profile.</p></div>
          <div class="profile-mode-tabs" role="tablist" aria-label="My Profile sections">
            <button type="button" class="profile-mode-tab is-active" data-profile-mode="content" role="tab" aria-selected="true"><span class="profile-mode-icon"><i class="app-icon icon-globe"></i></span><span><strong>Public Content</strong><small>Manage links, shop picks, and visibility.</small></span></button>
            <button type="button" class="profile-mode-tab" data-profile-mode="edit" role="tab" aria-selected="false"><span class="profile-mode-icon"><i class="app-icon icon-user"></i></span><span><strong>Edit Profile</strong><small>Update your name, username, bio, avatar, and socials.</small></span></button>
          </div>
          <div class="profile-mode-panel" data-profile-mode-panel="content" role="tabpanel">
            <div class="profile-content-layout profile-content-layout-simple">
              <div class="settings-main-column">
                <article class="settings-card public-content-card"><div class="settings-card-heading"><div><h3><i class="app-icon icon-globe"></i> Profile visibility</h3><p>Control whether visitors can open your public profile.</p></div><label class="toggle-control"><input type="checkbox" id="public-profile-published"><span></span><b>Published</b></label></div><div class="public-content-summary"><strong id="public-profile-counts">0 public links · 0 shop picks</strong><span>Only links and shop picks marked public appear on your shareable profile.</span></div></article>
                <section class="settings-card public-featured-card" aria-labelledby="public-featured-heading"><div class="public-section-heading"><div><h3 id="public-featured-heading"><i class="app-icon icon-bookmark"></i> Featured content</h3><p>Choose one public link, social post, or shop pick visitors should see first.</p></div><button type="button" class="settings-inline-action" id="public-featured-change">Change featured</button></div><div id="public-featured-current" class="public-featured-current"><span class="public-featured-thumb">↗</span><div><strong id="public-featured-title">No featured content selected</strong><small id="public-featured-meta">Choose from all public links or shop picks.</small><p id="public-featured-description"></p></div></div></section>
                <section class="settings-card public-curation-card" aria-labelledby="public-links-heading"><div class="public-section-heading"><div><h3 id="public-links-heading"><i class="app-icon icon-link"></i> Links</h3><p>Public My Links and social posts are combined here. Remove an item to make it private.</p></div><strong class="public-section-count" id="public-links-count">0</strong></div><div id="public-links-list" class="public-curation-scroll" aria-live="polite"></div><p id="public-links-empty" class="public-curation-empty" hidden>No public links or social posts yet.</p></section>
                <section class="settings-card public-profile-shop public-curation-card" aria-labelledby="public-shop-heading"><div class="public-section-heading"><div><h3 id="public-shop-heading"><i class="app-icon icon-bag"></i> Shop picks</h3><p>Add affiliate links and products you recommend. The five newest picks stay visible first.</p></div><button type="button" class="settings-inline-action" id="public-profile-add-shop">Add pick</button></div><div id="public-profile-shop-links" class="public-curation-scroll"></div></section>
                <div class="public-profile-content-actions"><span id="public-content-status" role="status"></span><button type="button" class="btn-secondary" id="public-profile-preview-content">Preview profile</button><button type="button" class="btn-secondary" id="public-profile-copy-content">Copy profile URL</button><button type="button" class="btn-primary" id="public-profile-save-content">Save profile</button></div>
              </div>
            </div>
          </div>
          <div class="profile-mode-panel" data-profile-mode-panel="edit" role="tabpanel" hidden>
            <div class="settings-layout profile-edit-layout">
              <div class="settings-main-column">
                <article class="settings-card public-profile-card"><div class="settings-card-heading"><div><h3><i class="app-icon icon-user"></i> Edit Profile</h3><p>Update the identity visitors see on your public SocialFeed profile.</p></div></div><form id="public-profile-form"><div class="public-profile-fields"><label>Username<input id="public-profile-username" name="username" pattern="[a-z0-9-]{3,30}" required><small>Your profile URL: <span id="public-profile-url">/u/socialfeed</span></small></label><label>Display name<input id="public-profile-display-name" name="displayName" maxlength="80"></label><label>Avatar URL<input id="public-profile-avatar" name="avatar" type="url" placeholder="https://…"></label><label>Theme preset<select id="public-profile-theme"><option value="default">Clean</option><option value="paper">Paper</option><option value="midnight">Midnight</option></select></label><label class="full-width">Bio<textarea id="public-profile-bio" name="bio" maxlength="280" rows="3" placeholder="A short introduction…"></textarea></label></div><div class="public-profile-social"><div class="settings-card-heading"><strong>Social links</strong><button type="button" class="settings-inline-action" id="public-profile-add-social">Add link</button></div><div id="public-profile-social-links"></div></div><div class="public-profile-actions"><span id="public-profile-status" role="status"></span><button type="button" class="btn-secondary" id="public-profile-preview">Preview</button><button type="button" class="btn-secondary" id="public-profile-copy">Copy URL</button><button type="submit" class="btn-primary" id="public-profile-save">Save profile</button></div></form></article>
              </div>
            </div>
          </div>
        </section>

        <section class="feed-content" id="feed-content">
          <div class="feed-section-header" id="feed-section-header" hidden aria-hidden="true">
            <div class="feed-title-area">
              <div class="feed-title-row"><h2 id="feed-title">My Links</h2></div>
              <p id="feed-subtitle">Showing 0 loaded links</p>
            </div>
          </div>

          <div class="feed-options-layer" id="feed-options-layer" hidden>
            <button type="button" class="feed-options-backdrop" id="feed-options-backdrop" aria-label="Close options"></button>
            <aside class="feed-options-drawer" id="feed-options-drawer" aria-label="Feed options" aria-hidden="true">
              <div class="feed-options-handle" aria-hidden="true"></div>
              <div class="feed-options-heading"><h3>All Options <span class="feed-loaded-count" id="feed-loaded-count" title="Showing 0 loaded links" data-tooltip="Showing 0 loaded links" aria-label="Showing 0 loaded links">0</span></h3><button type="button" id="feed-options-clear">Clear all</button></div>
              <div class="action-toolbar feed-options-grid" id="action-toolbar">
                <section class="feed-option-group feed-option-filters">
                  <span class="feed-option-label">FILTERS</span>
                  <div class="feed-option-controls" id="feed-filter-controls">
                    <div class="social-header-controls" id="social-header-controls" hidden>
                      <div class="toolbar-dropdown platform-filter-toolbar" id="platform-filter-dropdown" style="position: relative;" hidden>
                        <button class="toolbar-btn dropdown-toggle" id="platform-filter-btn" aria-label="Social Posts"
                          title="Social Posts" aria-expanded="false" type="button">
                          <i class="app-icon icon-circle-nodes"></i>
                          <span class="btn-label" id="platform-filter-label">All Posts</span>
                          <i class="app-icon icon-chevron-down toolbar-filter-chevron" aria-hidden="true"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" id="platform-filter-menu" role="menu">
                          <button class="dropdown-item active" data-platform="all" data-sidebar-route="#platform=all" role="menuitem" type="button"><i class="app-icon icon-check check-icon"></i><i class="app-icon icon-circle-nodes"></i><span class="btn-text">All Posts</span><span class="menu-count is-loading" id="count-platform-all" aria-busy="true"><i class="app-icon icon-circle-notch icon-spin" aria-hidden="true"></i><span class="sr-only">Loading count</span></span></button>
                          <button class="dropdown-item" data-platform="instagram" data-sidebar-route="#platform=instagram" role="menuitem" type="button"><i class="app-icon icon-check check-icon" style="visibility: hidden;"></i><i class="app-icon icon-instagram"></i><span class="btn-text">Instagram</span><span class="menu-count is-loading" id="count-platform-instagram" aria-busy="true"><i class="app-icon icon-circle-notch icon-spin" aria-hidden="true"></i><span class="sr-only">Loading count</span></span></button>
                          <button class="dropdown-item" data-platform="x" data-sidebar-route="#platform=x" role="menuitem" type="button"><i class="app-icon icon-check check-icon" style="visibility: hidden;"></i><svg class="platform-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2h3.3l-7.2 8.2 8.5 11.8h-6.7l-5.2-6.9-6 6.9H2.3l7.7-8.8L1.9 2h6.8l4.7 6.3L18.9 2Zm-1.2 17.9h1.8L7.7 4H5.8l11.9 15.9Z"/></svg><span class="btn-text">X / Twitter</span><span class="menu-count is-loading" id="count-platform-x" aria-busy="true"><i class="app-icon icon-circle-notch icon-spin" aria-hidden="true"></i><span class="sr-only">Loading count</span></span></button>
                          <button class="dropdown-item" data-platform="threads" data-sidebar-route="#platform=threads" role="menuitem" type="button"><i class="app-icon icon-check check-icon" style="visibility: hidden;"></i><svg class="platform-inline-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.6 11.1c-.2-3.5-2.2-5.5-5.6-5.5-2 0-3.7.8-4.7 2.3l1.7 1.2c.7-.9 1.7-1.4 3-1.4 1.9 0 3.1 1 3.4 2.8-.9-.2-1.9-.3-3-.2-2.9.2-4.7 1.6-4.6 3.8.1 2.1 1.9 3.5 4.4 3.4 2.2-.1 3.8-1.2 4.7-3.1.7.5 1.1 1.2 1.1 2.1 0 2.6-2.5 4.4-6 4.4-4.3 0-7-3.2-7-8.7 0-5.4 2.7-8.7 7-8.7 3.1 0 5.4 1.5 6.7 4.4l2-.9C19.1 3.7 16 2 12 2 6.4 2 3 5.9 3 12.2 3 18.5 6.4 22 12 22c4.8 0 8.1-2.5 8.1-6.2 0-2.1-.9-3.6-2.5-4.7Zm-5.5 4.3c-1.2-.1-2.1-.5-2.1-1.4 0-.9.9-1.5 2.5-1.6 1-.1 2 0 2.8.3-.4 1.6-1.5 2.6-3.2 2.7Z"/></svg><span class="btn-text">Threads</span><span class="menu-count is-loading" id="count-platform-threads" aria-busy="true"><i class="app-icon icon-circle-notch icon-spin" aria-hidden="true"></i><span class="sr-only">Loading count</span></span></button>
                          <button class="dropdown-item" data-platform="reddit" data-sidebar-route="#platform=reddit" role="menuitem" type="button"><i class="app-icon icon-check check-icon" style="visibility: hidden;"></i><i class="app-icon icon-reddit-alien"></i><span class="btn-text">Reddit</span><span class="menu-count is-loading" id="count-platform-reddit" aria-busy="true"><i class="app-icon icon-circle-notch icon-spin" aria-hidden="true"></i><span class="sr-only">Loading count</span></span></button>
