            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px;">
              <button type="button" class="btn-secondary" id="btn-add-cancel">Cancel</button>
              <button type="submit" class="btn-primary">Add to Feed</button>
            </div>
          </form>
        </div>
