---
import "../../styles/public-profile.css";
import { SOCIAL_ICON_DEFINITIONS, socialIconMarkup } from "../../features/dashboard/ui/social-icons.js";

export interface Props {
  profile: Record<string, any>;
  browserBookmarks?: Record<string, any>[];
  socialBookmarks?: Record<string, any>[];
}

const {
  profile,
  browserBookmarks = [],
  socialBookmarks = [],
} = Astro.props;

const displayName = profile.displayName || profile.username || "SocialFeed Owner";
const username = profile.username || "socialfeed";
const initials = displayName.trim().charAt(0).toUpperCase() || "S";
const accent = profile.theme?.accent || "#f43f5e";
const theme = profile.theme?.background || "default";
const safeHttp = (value = "") => {
  try {
    const url = new URL(String(value));
    return ["http:", "https:"].includes(url.protocol) ? url.toString() : "";
  } catch {
    return "";
  }
};
const safeImage = (value = "") => {
  const raw = String(value || "").trim();
  return /^data:image\/(?:png|jpe?g|webp|gif);base64,[A-Za-z0-9+/=]+$/i.test(raw) ? raw : safeHttp(raw);
};
const hostFor = (value = "") => {
  try {
    return new URL(value).hostname.replace(/^www\./, "");
  } catch {
    return "";
  }
};
const labelForBookmark = (bookmark: Record<string, any>) =>
  bookmark.publicTitle || bookmark.title || bookmark.authorName || bookmark.siteName || bookmark.content || hostFor(bookmark.url) || "Saved link";
const descriptionForBookmark = (bookmark: Record<string, any>) =>
  bookmark.publicDescription || bookmark.content || "Open the original link";
const dateFor = (value: unknown) => {
  const date = new Date(String(value || ""));
  return Number.isNaN(date.getTime())
    ? ""
    : date.toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
};

const socialPlatforms = new Set(Object.keys(SOCIAL_ICON_DEFINITIONS).filter((platform) => platform !== "custom"));
const platformForSocial = (link: Record<string, any>) => {
  const declared = String(link.platform || "").toLowerCase();
  if (socialPlatforms.has(declared)) return declared;
  const host = hostFor(link.url);
  if (host.includes("instagram")) return "instagram";
  if (host === "x.com" || host.includes("twitter")) return "x";
  if (host.includes("threads")) return "threads";
  if (host.includes("facebook")) return "facebook";
  if (host.includes("tiktok")) return "tiktok";
  if (host.includes("telegram") || host === "t.me") return "telegram";
  return "custom";
};

const socialLinks = (profile.socialLinks || [])
  .map((link: Record<string, any>) => ({ ...link, href: safeHttp(link.url), platform: platformForSocial(link) }))
  .filter((link: Record<string, any>) => link.href);
const browserLinks = browserBookmarks.filter((bookmark) => safeHttp(bookmark.url));
const savedPosts = socialBookmarks.filter((bookmark) => safeHttp(bookmark.url));
const dateValue = (value: unknown) => {
  const date = new Date(String(value || ""));
  return Number.isNaN(date.getTime()) ? 0 : date.getTime();
};
const shopLinks = (profile.shopLinks || [])
  .map((item: Record<string, any>, index: number) => ({
    ...item,
    id: String(item.id || `shop_${index + 1}`),
    href: safeHttp(item.url),
    image: safeImage(item.thumbnail),
  }))
  .filter((item: Record<string, any>) => item.href && item.title);
const itemId = (item: Record<string, any>, fallback: string) => String(item.id || fallback).replace(/[^a-zA-Z0-9_-]/g, "-").slice(0, 48);
const publicLinks = [
  ...browserLinks.map((bookmark, index) => ({
    ...bookmark,
    id: String(bookmark.id || `link-${index + 1}`),
    href: safeHttp(bookmark.url),
    title: labelForBookmark(bookmark),
    description: descriptionForBookmark(bookmark),
    sourceLabel: hostFor(bookmark.url),
    kind: "Public link",
    publishedAt: bookmark.publicPublishedAt || bookmark.visibilityUpdatedAt || bookmark.firstSavedAt || bookmark.createdAt,
    image: safeImage(bookmark.thumbnail || bookmark.favicon),
  })),
  ...savedPosts.map((bookmark, index) => ({
    ...bookmark,
    id: String(bookmark.id || `post-${index + 1}`),
    href: safeHttp(bookmark.url),
    title: labelForBookmark(bookmark),
    description: descriptionForBookmark(bookmark),
    sourceLabel: bookmark.platformName || bookmark.platform || "Social post",
    kind: "Social post",
    publishedAt: bookmark.publicPublishedAt || bookmark.visibilityUpdatedAt || bookmark.firstSavedAt || bookmark.createdAt,
    image: safeImage(bookmark.thumbnail),
  })),
].sort((a, b) => dateValue(b.publishedAt) - dateValue(a.publishedAt));
const featuredShop = shopLinks.find((item) => item.featured);
const featuredShopAsLink = featuredShop ? {
  ...featuredShop,
  kind: "Shop pick",
  title: featuredShop.title,
  description: featuredShop.description || "A recommendation from this profile.",
  sourceLabel: featuredShop.merchant || "Shop pick",
  url: featuredShop.href,
  thumbnail: featuredShop.image,
  favicon: "",
} : null;
const featuredLink = publicLinks.find((item) => item.featured) || featuredShopAsLink || publicLinks[0];
const combinedLinkCount = Number(profile.counts?.browser ?? browserLinks.length) + Number(profile.counts?.social ?? savedPosts.length);
const profileItemData = [
  ...publicLinks.map((item, index) => ({
    id: itemId(item, `link-${index + 1}`), title: item.title, description: item.description, url: item.href,
    meta: `${item.sourceLabel}${dateFor(item.publishedAt) ? ` · ${dateFor(item.publishedAt)}` : ""}`, kind: item.kind, image: item.image,
  })),
  ...shopLinks.map((item, index) => ({
    id: itemId(item, `shop-${index + 1}`), title: item.title, description: item.description || "A recommendation from this profile.",
    url: item.href, meta: [item.merchant, item.price].filter(Boolean).join(" · "), kind: "Shop pick", image: item.image,
  })),
];
---

<div
  class={`public-profile-page public-profile-theme-${theme}`}
  data-profile-theme={theme}
  data-profile-mode="landing"
  style={`--profile-accent: ${accent};`}
>
  <div class="public-profile-shell">
    <header class="profile-hero">
      <a class="profile-dashboard-link" href="/dashboard" target="_blank" rel="noopener noreferrer" aria-label="Open dashboard" title="Open dashboard"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4V4Zm10 0h6v6h-6V4ZM4 14h6v6H4v-6Zm10 0h6v6h-6v-6Z" /></svg></a>
      <div class="profile-hero-top">
        <div class="profile-avatar" aria-label={`${displayName} profile picture`}>
        {safeImage(profile.avatarUrl) ? (
          <img src={safeImage(profile.avatarUrl)} alt={`${displayName} profile picture`} />
        ) : (
          <span>{initials}</span>
        )}
      </div>
        <div class="profile-identity">
        <p class="profile-eyebrow">Curated by</p>
        <h1>{displayName}</h1>
        <p class="profile-username">@{username}</p>
        {profile.bio ? <p class="profile-bio">{profile.bio}</p> : null}
        {socialLinks.length ? (
          <nav class="profile-social-links" aria-label={`${displayName} social links`}>
            {socialLinks.map((link) => (
              <a
                class={`profile-social-icon profile-social-${link.platform}`}
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label || link.platform}
                title={link.label || link.platform}
              >
                <span aria-hidden="true" set:html={socialIconMarkup(link.platform)}></span>
                <span class="profile-sr-only">{link.label || link.platform}</span>
              </a>
            ))}
          </nav>
        ) : null}
        </div>
        <button class="profile-share" id="profile-share" type="button"><span aria-hidden="true">↗</span><span>Share profile</span></button>
      </div>
      <div class="profile-metrics" aria-label="Profile content counts">
        <div class="profile-metric"><span class="profile-metric-icon" aria-hidden="true">↗</span><strong>{combinedLinkCount}</strong><small>Links</small></div>
        <div class="profile-metric"><span class="profile-metric-icon" aria-hidden="true">♧</span><strong>{shopLinks.length}</strong><small>Shop picks</small></div>
      </div>
    </header>

    <nav class="profile-tabs" aria-label="Profile sections">
      <button type="button" class="active" data-profile-tab="links" aria-selected="true"><span class="profile-tab-icon" aria-hidden="true">↗</span> Links <span>{combinedLinkCount}</span></button>
      <button type="button" data-profile-tab="shop" aria-selected="false"><span class="profile-tab-icon" aria-hidden="true">♧</span> Shop <span>{shopLinks.length}</span></button>
    </nav>

    <main>
      {featuredLink ? <section class="profile-featured-section" aria-labelledby="featured-title">
        <div class="profile-section-heading"><div><p class="profile-eyebrow">Featured link</p><h2 id="featured-title">{labelForBookmark(featuredLink)}</h2></div><span class="profile-featured-note">Worth a visit</span></div>
        <article class="profile-featured-card" data-profile-item={itemId(featuredLink, "featured-link")}>
          <div class="profile-featured-icon">{safeImage(featuredLink.thumbnail || featuredLink.favicon) ? <img src={safeImage(featuredLink.thumbnail || featuredLink.favicon)} alt="" /> : <span>{labelForBookmark(featuredLink).charAt(0).toUpperCase()}</span>}</div>
          <div class="profile-featured-copy"><p>{descriptionForBookmark(featuredLink)}</p><span>{hostFor(featuredLink.url)}</span></div>
          <button type="button" class="profile-open-button" data-profile-open={itemId(featuredLink, "featured-link")}>Preview <span aria-hidden="true">↗</span></button>
          <a class="profile-card-link-overlay" href={featuredLink.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${labelForBookmark(featuredLink)} in a new tab`}></a>
        </article>
      </section> : null}

      {publicLinks.length ? <section class="profile-section profile-rail-section" id="links" aria-labelledby="links-title" data-profile-panel="links">
        <div class="profile-section-heading"><div><p class="profile-eyebrow">Latest first</p><h2 id="links-title">Public links</h2></div><div class="profile-section-actions"><button type="button" class="profile-arrow" data-profile-scroll="links" data-direction="prev" aria-label="Scroll public links left">←</button><button type="button" class="profile-arrow" data-profile-scroll="links" data-direction="next" aria-label="Scroll public links right">→</button><button type="button" class="profile-see-all" data-profile-see-all="links">See all <span aria-hidden="true">→</span></button></div></div>
        <div class="profile-collection-tools" data-profile-tools="links"><span>All public links</span><button type="button" class="profile-view-button is-active" data-profile-view="grid" data-profile-target="links">Grid</button><button type="button" class="profile-view-button" data-profile-view="list" data-profile-target="links">List</button></div>
        <div class="profile-link-rail profile-collection" data-profile-collection="links">
          {publicLinks.map((item, index) => <article class={`profile-link-card profile-link-card-${item.kind === "Social post" ? "post" : "link"}`} id={`item-${itemId(item, `link-${index + 1}`)}`} data-profile-item={itemId(item, `link-${index + 1}`)}><div class="profile-link-card-top"><span class="profile-link-favicon">{item.image ? <img src={item.image} alt="" loading="lazy" /> : <span>{item.title.charAt(0).toUpperCase()}</span>}</span><div class="profile-card-actions">{item.featured ? <span class="profile-featured">Featured</span> : null}<button type="button" class="profile-item-share" data-profile-share-item={itemId(item, `link-${index + 1}`)} aria-label={`Share ${item.title}`} title="Share link">↗</button></div></div><div class="profile-link-copy"><div class="profile-link-kind">{item.kind}</div><h3>{item.title}</h3><p>{item.description}</p><span class="profile-link-meta">{item.sourceLabel}{dateFor(item.publishedAt) ? ` · ${dateFor(item.publishedAt)}` : ""}</span></div><button type="button" class="profile-open-button" data-profile-open={itemId(item, `link-${index + 1}`)}>Preview <span aria-hidden="true">↗</span></button><a class="profile-card-link-overlay" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${item.title} in a new tab`}></a></article>)}
        </div>
      </section> : null}

      {shopLinks.length ? <section class="profile-section profile-rail-section" id="shop" aria-labelledby="shop-title" data-profile-panel="shop">
        <div class="profile-section-heading"><div><p class="profile-eyebrow">Curated finds</p><h2 id="shop-title">Shop picks</h2></div><div class="profile-section-actions"><button type="button" class="profile-arrow" data-profile-scroll="shop" data-direction="prev" aria-label="Scroll shop picks left">←</button><button type="button" class="profile-arrow" data-profile-scroll="shop" data-direction="next" aria-label="Scroll shop picks right">→</button><button type="button" class="profile-see-all" data-profile-see-all="shop">See all <span aria-hidden="true">→</span></button></div></div>
        <div class="profile-collection-tools" data-profile-tools="shop"><span>All shop picks</span><button type="button" class="profile-view-button is-active" data-profile-view="grid" data-profile-target="shop">Grid</button><button type="button" class="profile-view-button" data-profile-view="list" data-profile-target="shop">List</button></div>
        <div class="profile-shop-rail profile-collection" data-profile-collection="shop">
          {shopLinks.map((item, index) => (
            <article class="profile-shop-card" id={`item-${itemId(item, `shop-${index + 1}`)}`} data-profile-item={itemId(item, `shop-${index + 1}`)}>
              {item.image ? <img src={item.image} alt="" loading="lazy" /> : <div class="profile-shop-placeholder"><span aria-hidden="true">✦</span></div>}
              <div class="profile-shop-body">
                <div class="profile-shop-kicker"><span>{item.merchant || "Partner pick"}</span>{item.price ? <strong>{item.price}</strong> : null}</div>
                <h3>{item.title}</h3>
                {item.description ? <p>{item.description}</p> : null}
                <div class="profile-card-footer"><button type="button" class="profile-open-button" data-profile-open={itemId(item, `shop-${index + 1}`)}>Preview <span aria-hidden="true">↗</span></button><button type="button" class="profile-item-share" data-profile-share-item={itemId(item, `shop-${index + 1}`)} aria-label={`Share ${item.title}`} title="Share pick">↗</button></div>
              </div>
              <a class="profile-card-link-overlay" href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${item.title} in a new tab`}></a>
            </article>
          ))}
        </div>
      </section> : null}
    </main>

    <footer class="profile-footer">
      <a class="profile-footer-cta" href="/">Join SocialFeed <span aria-hidden="true">↗</span></a>
      <span>Organize the web you want to remember.</span>
      <span>© {new Date().getFullYear()} SocialFeed Hub</span>
    </footer>
  </div>

  <dialog class="profile-item-dialog" id="profile-item-dialog" aria-labelledby="profile-dialog-title">
    <button class="profile-dialog-close" type="button" data-profile-dialog-close aria-label="Close preview">×</button>
    <div class="profile-dialog-image" data-profile-dialog-image hidden></div>
    <p class="profile-eyebrow" data-profile-dialog-kicker>Public pick</p>
    <h2 id="profile-dialog-title" data-profile-dialog-title>Preview</h2>
    <p data-profile-dialog-description></p>
    <div class="profile-dialog-meta" data-profile-dialog-meta></div>
    <div class="profile-dialog-actions"><a class="profile-dialog-primary" data-profile-dialog-link href="#" target="_blank" rel="noopener noreferrer">Open original <span aria-hidden="true">↗</span></a><button type="button" class="profile-dialog-secondary" data-profile-dialog-share>Share</button></div>
  </dialog>
  <script type="application/json" id="profile-item-data" set:html={JSON.stringify(profileItemData)}></script>
</div>

<script>
  const page = document.querySelector(".public-profile-page");
  const shareButton = document.getElementById("profile-share");
  shareButton?.addEventListener("click", async () => {
    const shareData = { title: document.title, url: window.location.href };
    try {
      if (navigator.share) await navigator.share(shareData);
      else await navigator.clipboard.writeText(window.location.href);
      shareButton.innerHTML = "<span aria-hidden=\"true\">✓</span> Link copied";
      window.setTimeout(() => { shareButton.innerHTML = "<span aria-hidden=\"true\">↗</span> Share profile"; }, 2200);
    } catch {
      // The user can still copy the URL from the browser address bar.
    }
  });

  const profileTabs = Array.from(document.querySelectorAll("[data-profile-tab]"));
  const setActiveTab = (name) => profileTabs.forEach((tab) => {
    const active = tab.dataset.profileTab === name;
    tab.classList.toggle("active", active);
    tab.setAttribute("aria-selected", String(active));
  });
  const updateProfileRoute = (route) => {
    const nextUrl = `${window.location.pathname}#${route}`;
    if (`${window.location.pathname}${window.location.hash}` !== nextUrl) history.replaceState(null, "", nextUrl);
  };
  const resetCollectionView = (name) => {
    const collection = document.querySelector(`[data-profile-collection="${name}"]`);
    if (collection) collection.classList.remove("is-list");
    document.querySelectorAll(`[data-profile-target="${name}"]`).forEach((button) => button.classList.toggle("is-active", button.dataset.profileView === "grid"));
  };
  const showLanding = (shouldScroll = false, updateHash = true) => {
    document.querySelectorAll("[data-profile-panel]").forEach((section) => section.classList.remove("is-expanded"));
    page?.setAttribute("data-profile-mode", "landing");
    setActiveTab("links");
    if (updateHash) updateProfileRoute("links");
    if (shouldScroll) document.querySelector("#links")?.scrollIntoView({ behavior: "smooth", block: "start" });
  };
  const showLandingSection = (name, route) => {
    document.querySelectorAll("[data-profile-panel]").forEach((section) => section.classList.remove("is-expanded"));
    page?.setAttribute("data-profile-mode", "landing");
    setActiveTab(name);
    updateProfileRoute(route);
    document.querySelector(`#${name}`)?.scrollIntoView({ behavior: "smooth", block: "start" });
  };
  const showAll = (name, shouldScroll = true) => {
    const section = document.querySelector(`[data-profile-panel="${name}"]`);
    if (!section) return showLanding(shouldScroll);
    resetCollectionView(name);
    section.classList.add("is-expanded");
    page?.setAttribute("data-profile-mode", `all-${name}`);
    setActiveTab(name);
    updateProfileRoute(`all-${name}`);
    if (shouldScroll) section.scrollIntoView({ behavior: "smooth", block: "start" });
  };
  profileTabs.forEach((tab) => tab.addEventListener("click", () => {
    const name = tab.dataset.profileTab || "links";
    if (name === "links") {
      showLandingSection("links", "links");
    } else {
      showLandingSection("shop", "shops");
    }
  }));
  document.querySelectorAll("[data-profile-see-all]").forEach((button) => button.addEventListener("click", () => showAll(button.dataset.profileSeeAll || "links")));
  document.querySelectorAll("[data-profile-scroll]").forEach((button) => button.addEventListener("click", () => {
    const rail = document.querySelector(`[data-profile-collection="${button.dataset.profileScroll}"]`);
    if (!rail) return;
    rail.scrollBy({ left: (button.dataset.direction === "prev" ? -1 : 1) * Math.max(260, rail.clientWidth * .78), behavior: "smooth" });
  }));
  document.querySelectorAll("[data-profile-view]").forEach((button) => button.addEventListener("click", () => {
    const target = button.dataset.profileTarget;
    const collection = document.querySelector(`[data-profile-collection="${target}"]`);
    if (!collection) return;
    collection.classList.toggle("is-list", button.dataset.profileView === "list");
    document.querySelectorAll(`[data-profile-target="${target}"]`).forEach((item) => item.classList.toggle("is-active", item === button));
  }));
  const initialRoute = window.location.hash.replace("#", "");
  if (initialRoute === "all-links") showAll("links", false);
  else if (initialRoute === "all-shop") showAll("shop", false);
  else if (initialRoute === "links") showLandingSection("links", "links");
  else if (initialRoute === "shops") showLandingSection("shop", "shops");
  else showLanding(false, false);

  const dialog = document.getElementById("profile-item-dialog");
  const dialogTitle = dialog?.querySelector("[data-profile-dialog-title]");
  const dialogDescription = dialog?.querySelector("[data-profile-dialog-description]");
  const dialogMeta = dialog?.querySelector("[data-profile-dialog-meta]");
  const dialogLink = dialog?.querySelector("[data-profile-dialog-link]");
  const dialogImage = dialog?.querySelector("[data-profile-dialog-image]");
  const items = new Map();
  const addItem = (id, item) => { if (id) items.set(id, item); };
  const serializedItems = document.getElementById("profile-item-data")?.textContent || "[]";
  JSON.parse(serializedItems).forEach((item) => addItem(item.id, item));
  const openItem = (id, updateUrl = true) => {
    const item = items.get(id); if (!item || !dialog) return;
    if (dialogTitle) dialogTitle.textContent = item.title;
    if (dialogDescription) dialogDescription.textContent = item.description;
    if (dialogMeta) dialogMeta.textContent = item.meta || item.kind;
    if (dialogLink) dialogLink.href = item.url;
    if (dialogImage) { dialogImage.hidden = !item.image; dialogImage.innerHTML = item.image ? `<img src="${item.image}" alt="">` : ""; }
    dialog.dataset.activeItem = id;
    if (!dialog.open) dialog.showModal();
    if (updateUrl) history.replaceState(null, "", `${window.location.pathname}?item=${encodeURIComponent(id)}`);
  };
  document.querySelectorAll("[data-profile-open]").forEach((button) => button.addEventListener("click", () => openItem(button.dataset.profileOpen)));
  document.querySelectorAll("[data-profile-item]").forEach((card) => card.addEventListener("click", (event) => {
    if (event.target.closest("button, a, [data-profile-open], [data-profile-share-item]")) return;
    const item = items.get(card.dataset.profileItem);
    if (item?.url) window.open(item.url, "_blank", "noopener,noreferrer");
  }));
  document.querySelectorAll("[data-profile-share-item]").forEach((button) => button.addEventListener("click", async (event) => {
    event.stopPropagation(); const id = button.dataset.profileShareItem; const url = `${window.location.origin}${window.location.pathname}?item=${encodeURIComponent(id || "")}`;
    try { if (navigator.share) await navigator.share({ title: document.title, url }); else await navigator.clipboard.writeText(url); button.textContent = "✓"; window.setTimeout(() => { button.textContent = "↗"; }, 1600); } catch { /* cancelled */ }
  }));
  dialog?.querySelector("[data-profile-dialog-close]")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
  dialog?.addEventListener("close", () => { if (window.location.search.includes("item=")) history.replaceState(null, "", `${window.location.pathname}${window.location.hash}`); });
  dialog?.querySelector("[data-profile-dialog-share]")?.addEventListener("click", async () => {
    const id = dialog.dataset.activeItem || ""; const url = `${window.location.origin}${window.location.pathname}?item=${encodeURIComponent(id)}`;
    try { if (navigator.share) await navigator.share({ title: document.title, url }); else await navigator.clipboard.writeText(url); } catch { /* cancelled */ }
  });
  const itemFromUrl = new URLSearchParams(window.location.search).get("item");
  if (itemFromUrl) openItem(itemFromUrl, false);
</script>
