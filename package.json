{
  "name": "Social_Feed_Hub-vercel",
  "version": "1.0.0",
  "description": "Premium Social Feed Bookmarks Dashboard backed by MongoDB Atlas and Cloudinary on Vercel Serverless.",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "dependencies": {
    "cloudinary": "^2.1.0",
    "dotenv": "^16.6.1",
    "mongodb": "^6.5.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "vite": "^8.2.0"
  }
}
